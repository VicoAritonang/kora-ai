# Kora AI — every configuration key (PROJECT_STRUCTURE §5). Copy to .env.
# Required keys are marked (*). Secrets never go in the repo.

# --- APP_
APP_ENV=local                         # local | staging | production
APP_PORT=8080
APP_PUBLIC_URL=http://localhost:8080
APP_WEB_ORIGIN=http://localhost:3000  # CORS origin and magic-link host
APP_LOG_LEVEL=info
APP_SESSION_KEY=                      # ≥32 chars outside local (CSRF HMAC)
APP_SERVICE_TOKEN=                    # bearer token for /internal/v1 (AI Lab)
APP_DESTINATIONS=OSA,UKY,TYO
APP_ORIGINS=JKT,SUB,DPS

# --- DB_, REDIS_
NEON_DB_URL=                          # (*) Neon connection string (DB_URL overrides it)
DB_URL=
DB_MAX_CONNS=10
REDIS_URL=redis://localhost:6379/0

# --- OPENAI_, JEV_
OPENAI_API_KEY=                       # (*)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=60s
OPENROUTER_API_KEY=                   # JEV via OpenRouter decisions API
JEV_BASE_URL=https://openrouter.ai/api/alpha
JEV_MODEL=typesafe/jev-1.13           # pinned; "latest" is refused
JEV_THRESHOLD=0.80

# --- MODEL_ (role → model; change and run `make eval`)
MODEL_PLANNER=gpt-5-mini
MODEL_PLANNER_FALLBACK=gpt-4.1-mini
MODEL_PLANNER_EFFORT=auto              # auto (per task signals, escalates once on failure) | minimal | low | medium | high
MODEL_EXTRACTOR=gpt-5-nano
MODEL_EXTRACTOR_FALLBACK=gpt-4o-mini
MODEL_EXTRACTOR_EFFORT=auto
MODEL_NARRATOR_EFFORT=auto
MODEL_EFFORT_MAX=medium               # ceiling for auto/escalation (latency guard)
MODEL_NARRATOR=gpt-5-mini
MODEL_NARRATOR_FALLBACK=gpt-4.1-mini
MODEL_RESEARCHER=gpt-5-mini
MODEL_SUMMARIZER=gpt-5-nano

# --- LIMIT_ (AI_SYSTEM_DESIGN §5)
LIMIT_MAX_STEPS=12
LIMIT_FLIGHT_SEARCHES=6
LIMIT_STAY_SEARCHES=6
LIMIT_ACTIVITY_SEARCHES=4
LIMIT_WEB_RESEARCH=3
LIMIT_COST_USD=0.30
LIMIT_RUN_TIMEOUT=120s
LIMIT_TOOL_TIMEOUT=15s
LIMIT_WEB_TIMEOUT=30s
LIMIT_MAX_CONCURRENT_RUNS=20
LIMIT_MAX_OUTPUT_TOKENS=4000

# --- POLICY_ (package builder)
POLICY_CONTINGENCY_PCT=10
POLICY_FX_BUFFER_PCT=3
POLICY_FX_MAX_AGE_DAYS=4
POLICY_MIN_STAY_RATING=7.0
POLICY_BUILDER_VERSION=pb-1.0.0
POLICY_BOOKING_WINDOW_DAYS=330

# --- Suppliers (sandbox until Fase 0 spikes are done)
SUPPLIER_FLIGHTS=sandbox              # sandbox | duffel
SUPPLIER_STAYS=sandbox                # sandbox | liteapi
SUPPLIER_FLIGHT_TTL=30m
SUPPLIER_STAY_TTL=60m
DUFFEL_ACCESS_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com
LITEAPI_API_KEY=
LITEAPI_BASE_URL=https://api.liteapi.travel/v3.0
LITEAPI_MARGIN=0
FX_PROVIDER=frankfurter               # frankfurter | static
FX_BASE_URL=https://api.frankfurter.app

# --- PERSONA_, MEMORY_
PERSONA_PACK=persona/packs/kora.persona
PERSONA_UNITS_PER_QUERY=4
PERSONA_BUDGET_TOKENS=4000
MEMORY_ENABLED=false                  # keep false until OpenPersona supports scope deletion
MEMORY_URL=http://localhost:8090
MEMORY_BUDGET_TOKENS=600
OPENPERSONA_EXTRACT_MODEL=openai:gpt-4o-mini

# --- GUARDRAILS_
GUARDRAILS_MODE=engine                # engine | off (off only in local)
GUARDRAILS_POLICY=guardrails/policy.yaml
GUARDRAILS_TOOLS=guardrails/tools.yaml
GUARDRAILS_SECRET=                    # ≥32 chars outside local; same on every instance

# --- TRACER_
TRACER_LAB_URL=                       # AI Lab ingest endpoint (optional)
TRACER_LAB_TOKEN=

# --- Agent Reliability Lab (arl/1, development only; rejected unless APP_ENV=local)
# Streams every run (spans per pipeline step, model calls, tools, retrieval,
# guardrails, evaluations, cost) to a local Lab: http://localhost:8000.
# Kora in docker compose → ws://host.docker.internal:8000/api/agent-lab/ws
# Kora on the host (go run) → ws://localhost:8000/api/agent-lab/ws
STAGE=                                # dev turns it on; anything else is a no-op
LAB_WS_URL=
LAB_TOKEN=                            # same value as the Lab's ARL_AUTH_TOKEN, if set
LAB_PROJECT_ID=                       # optional; default project
LAB_REQUIRED=false                    # true: fail loudly when the Lab is unreachable (strict tests)
LAB_SERVICE=kora/api                  # cmd/eval reports as kora/eval

# --- QUOTA_ (API_SPEC §8)
QUOTA_GUEST_RUNS_PER_DAY=10
QUOTA_USER_RUNS_PER_DAY=30
QUOTA_REQUESTS_PER_MINUTE=120
QUOTA_MAX_ACTIVE_RUNS_PER_USER=2
QUOTA_GUEST_SESSIONS_PER_IP_HOUR=20

# --- EMAIL_
EMAIL_PROVIDER=log                    # log (local: link printed in api logs) | smtp
EMAIL_FROM=Kora <no-reply@kora.local>
EMAIL_SMTP_ADDR=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=

# --- web
NEXT_PUBLIC_API_URL=http://localhost:8080
